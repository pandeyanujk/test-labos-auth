{
  "name": "test-labos-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone test app for LabOS auth (cookie -> /v1/ai-apps/me)",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.js",
    "start:dev": "LABOS_ENV=dev node server.js",
    "start:local-https": "TLS_CERT=certs/cert.pem TLS_KEY=certs/key.pem node server.js",
    "start:local-https:dev": "LABOS_ENV=dev TLS_CERT=certs/cert.pem TLS_KEY=certs/key.pem node server.js"
  }
}
